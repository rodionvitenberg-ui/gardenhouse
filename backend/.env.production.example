# Django — production environment
# Copy is created automatically by deploy/deploy.sh from this template.
# Secret values (DJANGO_SECRET_KEY, DB_PASSWORD) are generated on first deploy
# and stored in backend/.env on the server — never commit the real .env.

# Security
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# HTTP→HTTPS redirect is handled by nginx (certbot --redirect). Keep Django's
# own redirect OFF to avoid ERR_TOO_MANY_REDIRECTS behind the proxy.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_ALLOWED_HOSTS=maintest.site,193.181.216.124,127.0.0.1,localhost

# Sub-path the app is served from (nginx location /gardenhouse).
# Django uses this prefix for admin redirects and DRF pagination URLs.
DJANGO_FORCE_SCRIPT_NAME=/gardenhouse

# Origins allowed for unsafe (POST/PUT/DELETE) requests — set to the public site URL.
# Include both schemes: HTTP before SSL, HTTPS after certbot
DJANGO_CSRF_TRUSTED_ORIGINS=https://maintest.site,http://maintest.site

# Database (PostgreSQL) — created by deploy/install.sh
DB_NAME=gardenhouse_db
DB_USER=gardenhouse_user
DB_PASSWORD=change-me-generated-by-deploy-script
DB_HOST=localhost
DB_PORT=5432

# CORS — comma-separated origins
CORS_ALLOWED_ORIGINS=https://maintest.site,http://maintest.site

# Email (SMTP) — console backend in prod until SMTP is configured
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=