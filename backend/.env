# --- Django Core ---
DJANGO_SECRET_KEY=django-insecure-dev-key-change-in-production-do-not-use
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL) ---
DB_NAME=garden_db
DB_USER=garden_user
DB_PASSWORD=garden_pass123
DB_HOST=localhost
DB_PORT=5432

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8001

# --- Email (console backend for dev, SMTP for prod) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=