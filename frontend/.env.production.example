# Next.js — production environment
# NOTE: Next.js reads .env.production automatically during `next build`/`next start`.
# A real .env.production is created on the server by deploy/deploy.sh from this template.

# Public site URL (used by sitemap.ts / robots)
NEXT_PUBLIC_SITE_URL=https://maintest.site/gardenhouse

# Sub-path the app is served from — matches the nginx location block.
NEXT_PUBLIC_BASE_PATH=/gardenhouse

# Same-origin API path (Nginx proxies /gardenhouse/api → Django).
# No CORS needed because requests stay on the same origin.
NEXT_PUBLIC_API_URL=/gardenhouse/api

# Server-side API base (used by sitemap.ts for data fetching).
# Points directly at Gunicorn on localhost — avoids the public nginx round-trip.
API_URL=http://127.0.0.1:8001/api