# ============================================================
# Gardenhouse — Frontend production environment (шаблон)
# Этот файл копируется deploy.sh → frontend/.env.production
# ПРИМЕЧАНИЕ: NEXT_PUBLIC_* читаются на этапе `next build`,
# поэтому НЕ меняйте их без пересборки!
# ============================================================

# Публичный URL сайта (используется sitemap.ts / robots / каноникал)
NEXT_PUBLIC_SITE_URL=https://maintest.site/gardenhouse

# Sub-path, под которым приложение отдаётся (совпадает с location в nginx)
NEXT_PUBLIC_BASE_PATH=/gardenhouse

# API на том же origin — nginx проксирует /gardenhouse/api → Django.
# CORS не нужен: запросы остаются на одном origin.
NEXT_PUBLIC_API_URL=/gardenhouse/api

# Серверная база API (для sitemap.ts): напрямую к Gunicorn на localhost,
# минуя публичный round-trip через nginx.
API_URL=http://127.0.0.1:8000/api