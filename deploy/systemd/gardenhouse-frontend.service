# /etc/systemd/system/gardenhouse-frontend.service
# Next.js via `next start` on 127.0.0.1:3000 (behind nginx /gardenhouse).
#
# Requires a production build: frontend/.next from `npm run build`
# with NEXT_PUBLIC_BASE_PATH=/gardenhouse in .env.production.

[Unit]
Description=GardenHouse Next.js Frontend
After=network.target
Wants=network.target

[Service]
Type=simple
User=maintest
Group=maintest
WorkingDirectory=/var/www/gardenhouse/frontend
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node /var/www/gardenhouse/frontend/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/gardenhouse/frontend/.next

[Install]
WantedBy=multi-user.target
