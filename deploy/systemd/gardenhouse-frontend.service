[Unit]
Description=GardenHouse Next.js Frontend
After=network.target

[Service]
Type=simple
User=gardenhouse
Group=gardenhouse
WorkingDirectory=/var/www/gardenhouse/frontend
EnvironmentFile=/var/www/gardenhouse/frontend/.env.production
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/www/gardenhouse/frontend/.next

[Install]
WantedBy=multi-user.target