# GardenHouse Django (Gunicorn) — generated by deploy scripts
# Placeholders: __APP_USER__ __APP_GROUP__ __APP_DIR__

[Unit]
Description=GardenHouse Django API (Gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__APP_DIR__/backend
EnvironmentFile=__APP_DIR__/backend/.env
ExecStart=__APP_DIR__/backend/venv/bin/gunicorn core.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    --name gardenhouse-backend
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
# ProtectHome=true would block reading /home/* if ever needed; app lives under /var/www
ProtectSystem=full
ReadWritePaths=__APP_DIR__/backend/media __APP_DIR__/backend/staticfiles

[Install]
WantedBy=multi-user.target
