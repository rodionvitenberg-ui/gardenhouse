# GardenHouse Next.js (`next start`) — generated by deploy scripts
# Placeholders: __APP_USER__ __APP_GROUP__ __APP_DIR__
#
# Hardening intentionally light: ProtectSystem/PrivateTmp caused hard-to-debug
# hangs on some VPS images when Next touches cache/fonts under restricted paths.

[Unit]
Description=GardenHouse Next.js Frontend
After=network.target
Wants=network.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__APP_DIR__/frontend
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
# next start reads .env.production; NEXT_PUBLIC_* baked at build time
ExecStart=/usr/bin/node __APP_DIR__/frontend/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3
# Give first request enough time under load (avoid kill during slow boot)
TimeoutStartSec=120

# Logging to journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gardenhouse-frontend

[Install]
WantedBy=multi-user.target
