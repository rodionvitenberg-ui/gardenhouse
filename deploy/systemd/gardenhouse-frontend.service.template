# GardenHouse Next.js (`next start`) — generated by deploy scripts
# Placeholders: __APP_USER__ __APP_GROUP__ __APP_DIR__
#
# Requires production build with NEXT_PUBLIC_BASE_PATH=/gardenhouse
# (next.config must NOT set output:"standalone")

[Unit]
Description=GardenHouse Next.js Frontend
After=network.target
Wants=network.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__APP_DIR__/frontend
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
# next start reads frontend/.env.production for any remaining runtime needs;
# NEXT_PUBLIC_* are baked in at build time.
ExecStart=/usr/bin/node __APP_DIR__/frontend/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__APP_DIR__/frontend/.next

[Install]
WantedBy=multi-user.target
